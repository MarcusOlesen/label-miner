{"key": "https://moebelkompagniet.dk/products/frame-tv-stander.js?{}", "status": 200, "json": {"id": 15281014210937, "title": "Frame TV-stander", "handle": "frame-tv-stander", "description": "<p>Frame TV-stander er et boligtilbehør med en enkel form og bløde linjer, der skaber en rolig ramme om fjernsynet. Dens velafbalancerede design bringer håndværk og tidløshed ind i rummet og passer naturligt i både moderne og klassiske hjem.</p>\n<ul>\n<li>Passer til tv fra 43 til 75 tommer, hvilket giver fleksibel brug.</li>\n<li>Fås i naturligt eller røget egetræ, der tilfører varme og variation.</li>\n<li>Let at montere med fokus på funktionalitet og stil.<br>\n</li>\n<li>Kan holde max. 40 kg.</li>\n</ul>\n<p>Frame TV-stander er en del af<a href=\"https://moebelkompagniet.dk/collections/opbevaring\" title=\"Opbevaring\"> <strong>opbevaring.</strong></a></p>", "published_at": "2026-05-26T13:53:44+02:00", "created_at": "2025-12-18T17:37:51+01:00", "vendor": "FCL-CORE ONE", "type": "Boligtilbehør", "tags": ["ai-text-done", "Boligtilbehør", "Let-montering", "nyhed", "rotation-2", "skobsgaard", "Skovsgaard", "Udstillet i Aalborg"], "price": 219900, "price_min": 219900, "price_max": 219900, "available": true, "price_varies": false, "compare_at_price": null, "compare_at_price_min": 0, "compare_at_price_max": 0, "compare_at_price_varies": false, "variants": [{"id": 56373377139065, "title": "Røget egetræ", "option1": "Røget egetræ", "option2": null, "option3": null, "sku": "106838", "requires_shipping": true, "taxable": true, "featured_image": {"id": 79782244614521, "product_id": 15281014210937, "position": 14, "created_at": "2026-05-06T07:56:22+02:00", "updated_at": "2026-05-06T07:56:26+02:00", "alt": null, "width": 2000, "height": 2000, "src": "https://cdn.shopify.com/s/files/1/0562/2136/8384/files/31586-100LeoTVStandTVs43-75OakSmokedOil_02.jpg?v=1778046986", "variant_ids": [56373377139065]}, "available": true, "name": "Frame TV-stander - Røget egetræ", "public_title": "Røget egetr